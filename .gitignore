# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build/*
!/build/icon.icns

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# electron & local data
/dist-electron/
/.wireforge/
/data/

# test results & screenshots
/test-results/
*.png
*.jpg
*.jpeg
*.webp
!public/*.png
!public/*.jpg
!public/*.jpeg
!public/*.svg

# packet tracer agent harness
tools/packet-tracer/agent-harness/.venv/
tools/packet-tracer/agent-harness/.pytest_cache/
tools/packet-tracer/agent-harness/cli_anything/packet_tracer/utils/ptax
**/__pycache__/
*.egg-info/
docs/evaluation/private/
